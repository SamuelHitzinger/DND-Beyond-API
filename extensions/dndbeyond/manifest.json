{
  "manifest_version": 3,
  "name": "D&D Beyond Character API",
  "version": "1.0.2",
  "description": "Choose a D&D Beyond character for any local application. Desktop Chrome and Brave on Windows.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/picker.html",
    "default_title": "Choose your D&D Beyond character"
  },
  "options_page": "ui/setup.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "host_permissions": [
    "https://auth-service.dndbeyond.com/*",
    "https://character-service.dndbeyond.com/*",
    "https://character-service-scds.dndbeyond.com/*"
  ]
}
